# A graphical launcher can replace PATH after NixOS exported its init marker.
# Restore the normal profile environment when that happened, while preserving
# intentionally isolated nix-shell environments.
if [[ -z ${IN_NIX_SHELL-} && ":${PATH-}:" != *:/run/current-system/sw/bin:* ]]; then
  source /etc/set-environment
fi

# Keep the existing editing preferences; Home Manager handles completion/history.
bindkey -e
zstyle :compinstall filename '/home/ton/.config/nixos/zsh/.zshrc'
